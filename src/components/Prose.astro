---
// 正文排版：Markdown / MDX 渲染出来的内容都放在这里面。
import 'katex/dist/katex.min.css';
---

<div class="prose"><slot /></div>

<style>
  .prose {
    margin-top: 32px;
    font-size: 17px;
    line-height: 1.9;
    color: var(--ink-2);
  }
  .prose :global(h2) {
    margin: 2.2em 0 0.7em;
    font-size: 26px;
    color: var(--ink);
  }
  .prose :global(h3) {
    margin: 1.8em 0 0.6em;
    font-size: 21px;
    color: var(--ink);
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1em;
  }
  .prose :global(a) {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 3px;
    /* 参考资料里的长网址在窄屏上要能换行，否则会被裁掉 */
    overflow-wrap: anywhere;
  }
  .prose :global(strong) {
    color: var(--ink);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
  .prose :global(:not(pre) > code) {
    padding: 0.15em 0.4em;
    border-radius: 6px;
    background: var(--surface-2);
  }
  .prose :global(pre) {
    padding: 18px 20px;
    border-radius: 14px;
    border: 1px solid var(--line);
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.7;
  }
  .prose :global(.katex-display) {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 6px 0;
  }
  .prose :global(blockquote) {
    margin: 1.4em 0;
    padding: 4px 20px;
    border-left: 3px solid var(--accent);
    color: var(--muted);
  }
  .prose :global(img) {
    border-radius: 14px;
    margin: 1.6em auto;
  }
  .prose :global(figure) {
    margin: 1.8em 0;
  }
  .prose :global(figcaption) {
    margin-top: 8px;
    text-align: center;
    font-size: 14px;
    color: var(--muted);
  }
  .prose :global(table) {
    width: 100%;
    margin: 1.4em 0;
    border-collapse: collapse;
    font-size: 15px;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 8px 12px;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .prose :global(hr) {
    margin: 2.4em 0;
    border: 0;
    border-top: 1px solid var(--line);
  }
  .prose > :global(:first-child) {
    margin-top: 0;
  }
</style>

<style is:global>
  /* Shiki 双主题：跟随深色模式 */
  :root[data-theme='dark'] .astro-code,
  :root[data-theme='dark'] .astro-code span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .astro-code,
    :root:not([data-theme='light']) .astro-code span {
      color: var(--shiki-dark) !important;
      background-color: var(--shiki-dark-bg) !important;
    }
  }
</style>
