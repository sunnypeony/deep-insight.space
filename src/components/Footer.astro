---
import { site } from '../data/site';
import { useT, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p>
      <span class="name">{site.name}</span> · {t.footerTagline}
    </p>
    <p class="meta">
      {t.footerLang}
      <span aria-hidden="true">·</span>
      <a href={site.linkedin} rel="noopener">LinkedIn</a>
      <span aria-hidden="true">·</span>
      <a href={site.github} rel="noopener">GitHub</a>
      <span aria-hidden="true">·</span>
      <a href={site.youtubeChannel} rel="noopener">YouTube</a>
      <span aria-hidden="true">·</span>
      © {year}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 24px;
  }
  .inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-block: 32px 40px;
    color: var(--muted);
    font-size: 14px;
  }
  .name {
    color: var(--ink-2);
    font-weight: 600;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;
  }
  .meta a {
    color: var(--ink-2);
  }
  .meta a:hover {
    color: var(--brand);
  }
</style>
