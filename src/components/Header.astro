---
import { site, nav } from '../data/site';
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${site.name} 首页`}>
      <span class="mark" aria-hidden="true">D</span>
      <span class="brand-text">
        <span class="name">{site.name}</span>
        <span class="tag">{site.tagline}</span>
      </span>
    </a>

    <nav class="nav" aria-label="主导航">
      <ul id="nav-list">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="tools">
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="切换深色 / 浅色模式">
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
        </svg>
      </button>
      <button class="icon-btn menu-btn" id="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-list" aria-label="打开菜单">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeBtn = document.getElementById('theme-toggle');
  themeBtn?.addEventListener('click', () => {
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    window.dispatchEvent(new Event('themechange'));
  });

  const menuBtn = document.getElementById('menu-toggle');
  const header = document.querySelector('.site-header');
  menuBtn?.addEventListener('click', () => {
    const open = header?.classList.toggle('menu-open') ?? false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll('#nav-list a').forEach((a) =>
    a.addEventListener('click', () => {
      header?.classList.remove('menu-open');
      menuBtn?.setAttribute('aria-expanded', 'false');
    }),
  );

  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }
  .site-header.scrolled {
    border-bottom-color: var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 84px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    flex: none;
    border-radius: 13px;
    background: var(--brand);
    color: var(--brand-ink);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 26px;
    font-weight: 600;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }
  .name {
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.01em;
  }
  .tag {
    margin-top: 5px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    display: block;
    padding: 8px 14px;
    border-radius: 10px;
    color: var(--ink-2);
    font-size: 15px;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .nav a:hover {
    color: var(--brand);
    background: var(--surface-2);
  }
  .tools {
    display: flex;
    gap: 6px;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-2);
    cursor: pointer;
  }
  .icon-btn:hover {
    color: var(--brand);
    border-color: var(--line-strong);
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }
  }
  .menu-btn {
    display: none;
  }

  @media (max-width: 900px) {
    .bar {
      height: 72px;
    }
    .mark {
      width: 40px;
      height: 40px;
      font-size: 22px;
    }
    .tag {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
    .tools {
      margin-left: auto;
    }
    .nav {
      position: absolute;
      inset: 72px 0 auto 0;
      margin: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      display: none;
    }
    .site-header.menu-open .nav {
      display: block;
    }
    .nav ul {
      flex-direction: column;
      padding: 8px var(--gutter) 16px;
    }
    .nav a {
      padding: 12px 8px;
      font-size: 16px;
    }
  }
</style>
