---
// MDX 中可直接使用（无需 import）：<Callout title="...">内容</Callout>
// type 可选 note（默认）| tip | warning
interface Props {
  title?: string;
  type?: 'note' | 'tip' | 'warning';
}
const { title, type = 'note' } = Astro.props;
---

<aside class:list={['callout', type]}>
  {title && <p class="callout-title">{title}</p>}
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    margin: 1.6em 0;
    padding: 16px 20px;
    border-radius: 14px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--brand);
    background: var(--surface-2);
  }
  .callout.tip {
    border-left-color: var(--axis-y);
  }
  .callout.warning {
    border-left-color: var(--accent);
    background: var(--accent-soft);
  }
  .callout-title {
    margin: 0 0 4px;
    font-weight: 600;
    color: var(--ink);
  }
  .callout-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
