---
// 首页：只负责渲染。文案来自 content/pages/<lang>/home.md 与 about.md，
// 列表来自 content/topics、notes、projects、videos。
import BaseLayout from '../layouts/BaseLayout.astro';
import FrameViz from '../components/FrameViz.astro';
import YouTube from '../components/YouTube.astro';
import {
  assertContentRefs,
  byDateDesc,
  emphasisLines,
  entryHref,
  getListedNotes,
  getLocalized,
  getPage,
  getSettings,
  getTopics,
  hasBody,
  isVisible,
} from '../lib/content';
import { localizePath, useT, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
await assertContentRefs();

const site = await getSettings();
const home = (await getPage(lang, 'home')).data;
const about = (await getPage(lang, 'about')).data;
const topics = await getTopics(lang);
const topicTitle = new Map(topics.map((tp) => [tp.slug, tp.entry.data.title]));

// 首页列出全部笔记；草稿显示为“撰写中”，不生成链接（开发模式下可点击预览）
const allNotes = (await getListedNotes(lang)).sort(byDateDesc);
const notes = allNotes.slice(0, 5);
const countByTopic = (slug: string) => allNotes.filter((n) => n.entry.data.topic === slug && !n.entry.data.draft).length;

const projects = (await getLocalized('projects', lang)).sort((a, b) => a.entry.data.order - b.entry.data.order);
const projectHref = (p: (typeof projects)[number]) =>
  hasBody(p.entry) && isVisible(p.entry) ? entryHref('projects', p.lang, p.slug) : undefined;

const videos = (await getLocalized('videos', lang)).sort(byDateDesc);
const noteSlugs = new Map(allNotes.map((n) => [n.slug, n]));
const recipe = home.sections.recipe;
---

<BaseLayout lang={lang} description={home.description}>
  <!-- ───────── Hero ───────── -->
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">{home.hero.eyebrow}</p>
      <h1 class:list={[lang]}>
        {
          emphasisLines(home.hero.title).map((line, i) => (
            <>
              {i > 0 && <br />}
              {line.map((part) => (part.em ? <em>{part.text}</em> : part.text))}
            </>
          ))
        }
      </h1>
      <p class="lede">{home.hero.lede}</p>
      <div class="cta">
        <a class="btn btn-primary" href="#map">
          {home.hero.primaryCta}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
        </a>
        <a class="btn btn-ghost" href={site.links.linkedin} target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"></path></svg>
          {home.hero.authorCta}
          <span class="sr-only">(LinkedIn)</span>
        </a>
      </div>
      <dl class="stats">
        <div><dt>{home.stats.tracks}</dt><dd>{topics.length}</dd></div>
        <div><dt>{home.stats.notes}</dt><dd>{allNotes.length}</dd></div>
        <div><dt>{home.stats.thread}</dt><dd>{home.stats.threadValue}</dd></div>
      </dl>
    </div>
    <div class="hero-viz">
      <FrameViz lang={lang} />
    </div>
  </section>

  <!-- ───────── Knowledge map ───────── -->
  <section id="map" class="section container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">{home.sections.map.eyebrow}</p>
        <h2>{home.sections.map.title}</h2>
      </div>
      {home.sections.map.aside && <p class="aside">{home.sections.map.aside}</p>}
    </div>

    <ol class="route reveal" aria-label={t.routeLabel}>
      {
        topics.map(({ slug, entry }, i) => {
          const n = countByTopic(slug);
          const tp = entry.data;
          return (
            <li>
              <a class="topic" href={entryHref('topics', lang, slug)}>
                <span class="node" aria-hidden="true" />
                <span class="topic-index">
                  {String(i + 1).padStart(2, '0')} / {tp.eyebrow}
                </span>
                <h3>{tp.title}</h3>
                <p class="topic-summary">{tp.summary}</p>
                <ul class="kw">
                  {tp.keywords.map((k) => (
                    <li>{k}</li>
                  ))}
                </ul>
                <span class="topic-foot">
                  <span class={n ? 'chip chip-live' : 'chip chip-soon'}>{n ? t.noteCount(n) : t.comingSoon}</span>
                  <svg class="go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <path d="M7 17 17 7M8 7h9v9" />
                  </svg>
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>

  <!-- ───────── Article recipe ───────── -->
  <section class="recipe-wrap container reveal" aria-labelledby="recipe-title">
    <div class="recipe">
      <div class="recipe-head">
        <p class="eyebrow">{recipe.eyebrow}</p>
        <h2 id="recipe-title">{recipe.title}</h2>
      </div>
      <ol class="steps">
        {
          recipe.steps.map((s, i) => (
            <li>
              <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="step-t">{s.step}</span>
              <span class="step-d">{s.desc}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ───────── Notes + About ───────── -->
  <section id="notes" class="section container split">
    <div class="notes reveal">
      <div class="section-head">
        <div>
          <p class="eyebrow">{home.sections.notes.eyebrow}</p>
          <h2>{home.sections.notes.title}</h2>
        </div>
        {home.sections.notes.aside && <p class="aside">{home.sections.notes.aside}</p>}
      </div>
      <ul class="note-list">
        {
          notes.map((n) => {
            const d = n.entry.data;
            const inner = (
              <>
                <span class="note-label">{topicTitle.get(d.topic)}</span>
                <span class="note-main">
                  <span class="note-title">{d.title}</span>
                  <span class="note-desc">{d.summary}</span>
                </span>
                <span class="note-meta">
                  {n.fallback && <span class="chip">{t.otherLang}</span>}
                  {d.draft ? (
                    <span class="chip chip-soon">{t.draft}</span>
                  ) : (
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                      <path d="M7 17 17 7M8 7h9v9" />
                    </svg>
                  )}
                </span>
              </>
            );
            return (
              <li>
                {isVisible(n.entry) ? (
                  <a class="note" href={entryHref('notes', n.lang, n.slug)}>
                    {inner}
                  </a>
                ) : (
                  <div class="note is-draft">{inner}</div>
                )}
              </li>
            );
          })
        }
      </ul>
      <a class="more-link" href={localizePath('/notes/', lang)}>{t.allNotes} →</a>
    </div>

    <aside id="about" class="about reveal" aria-labelledby="about-title">
      <p class="eyebrow">About this space</p>
      <h2 id="about-title" class:list={['about-title', lang]}>
        {
          about.headline
            .trim()
            .split('\n')
            .map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))
        }
      </h2>
      <p class="about-body">{about.summary}</p>
      <ol class="journey" aria-label={t.journeyLabel}>
        {about.journey.map((j) => <li>{j}</li>)}
      </ol>
      <div class="about-links">
        <a href={localizePath('/about/', lang)}>{t.readMore} →</a>
        <a href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href={site.links.github} target="_blank" rel="noopener">GitHub ↗</a>
        {site.links.email && <a href={`mailto:${site.links.email}`}>Email ↗</a>}
      </div>
    </aside>
  </section>

  <!-- ───────── Projects ───────── -->
  <section id="projects" class="section container">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">{home.sections.projects.eyebrow}</p>
        <h2>{home.sections.projects.title}</h2>
      </div>
      {home.sections.projects.aside && <p class="aside">{home.sections.projects.aside}</p>}
    </div>
    <div class="projects">
      {
        projects.map((p, i) => {
          const d = p.entry.data;
          const href = projectHref(p);
          return (
            <article class="project reveal">
              <div class="project-top">
                <span class="project-n">P{String(i + 1).padStart(2, '0')}</span>
                <span class={d.status === 'planned' ? 'chip chip-soon' : 'chip chip-live'}>{t.status[d.status]}</span>
              </div>
              <h3>{href ? <a href={href}>{d.title} →</a> : d.title}</h3>
              <p>{d.summary}</p>
              <ul class="tags">
                {d.tags.map((tag) => (
                  <li class="chip">{tag}</li>
                ))}
              </ul>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- ───────── Videos ───────── -->
  <section id="videos" class="section container">
    <div class="videos-band reveal">
      <div class="videos-intro">
        <span class="play-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
        </span>
        <div>
          <p class="eyebrow">{home.sections.videos.eyebrow}</p>
          <h2>{home.sections.videos.title}</h2>
          {home.sections.videos.aside && <p class="aside">{home.sections.videos.aside}</p>}
        </div>
        <a class="btn btn-ghost videos-cta" href={site.links.youtube} target="_blank" rel="noopener">{home.sections.videos.cta} ↗</a>
      </div>

      <div class="video-grid">
        {
          videos.map((v) => {
            const d = v.entry.data;
            const note = d.note ? noteSlugs.get(d.note) : undefined;
            return (
              <article class="video">
                {d.youtubeId ? (
                  <YouTube id={d.youtubeId} title={d.title} lang={lang} />
                ) : (
                  <div class="video-placeholder" aria-hidden="true">
                    <span class="chip chip-soon">{t.inProduction}</span>
                  </div>
                )}
                <p class="video-topic">{d.label}</p>
                <h3>{note && isVisible(note.entry) ? <a href={entryHref('notes', note.lang, note.slug)}>{d.title}</a> : d.title}</h3>
                <p class="video-summary">{d.summary}</p>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(40px, 8vw, 96px) clamp(32px, 6vw, 64px);
  }
  h1 {
    margin-top: 22px;
    font-size: clamp(38px, 5.6vw, 66px);
    line-height: 1.18;
    letter-spacing: 0.005em;
  }
  h1.en {
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  h1 em {
    font-style: normal;
    color: var(--brand);
    background: linear-gradient(transparent 70%, var(--accent-soft) 70%);
    padding-inline: 2px;
  }
  .lede {
    margin-top: 24px;
    max-width: 36em;
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.85;
    color: var(--ink-2);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 36px;
    margin: 40px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .stats dt {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.1em;
  }
  .stats dd {
    margin: 2px 0 0;
    font-family: var(--font-serif);
    font-size: 22px;
  }

  /* ── Knowledge route ── */
  .route {
    --cols: 5;
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 22px 0 0;
  }
  .route::before {
    content: '';
    position: absolute;
    top: 6px;
    left: 26px;
    right: 26px;
    border-top: 1px dashed var(--line-strong);
  }
  .topic {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 28px 24px 22px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .topic:hover {
    transform: translateY(-4px);
    border-color: var(--brand);
  }
  .node {
    position: absolute;
    top: -22px;
    left: 24px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--brand);
    transform: translateY(-50%);
    transition: background-color 0.25s ease;
  }
  .topic:hover .node {
    background: var(--brand);
  }
  .topic-index {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brand);
  }
  .topic h3 {
    margin-top: 22px;
    font-size: 22px;
  }
  .topic-summary {
    margin-top: 10px;
    font-size: 14px;
    color: var(--ink-2);
    line-height: 1.7;
  }
  .kw {
    list-style: none;
    margin: 16px 0 0;
    padding: 14px 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 4px;
    font-size: 13.5px;
    color: var(--muted);
  }
  .kw li::before {
    content: '·';
    margin-right: 8px;
    color: var(--accent);
  }
  .topic-foot {
    margin-top: auto;
    padding-top: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--brand);
  }
  .go {
    transition: transform 0.25s ease;
  }
  .topic:hover .go {
    transform: translate(2px, -2px);
  }

  /* ── Recipe ── */
  .recipe {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
    gap: 32px;
    align-items: center;
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }
  .recipe-head h2 {
    margin-top: 10px;
    font-size: clamp(22px, 2.6vw, 28px);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
    counter-reset: s;
  }
  .steps li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 14px 16px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .step-n {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
  }
  .step-t {
    font-family: var(--font-serif);
    font-size: 18px;
  }
  .step-d {
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--muted);
  }

  /* ── Notes + About ── */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
    gap: clamp(32px, 4vw, 48px);
    align-items: start;
  }
  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .note-list li {
    border-bottom: 1px solid var(--line);
  }
  .note {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr) auto;
    gap: 8px 24px;
    align-items: baseline;
    padding: 26px 4px;
    transition: background-color 0.2s ease;
  }
  a.note:hover {
    background: color-mix(in srgb, var(--surface-2) 60%, transparent);
  }
  a.note:hover .note-title {
    color: var(--brand);
  }
  .note-label {
    font-size: 13px;
    color: var(--brand);
  }
  .note-main {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .note-title {
    font-family: var(--font-serif);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.45;
    transition: color 0.2s ease;
  }
  .note-desc {
    font-size: 14px;
    color: var(--muted);
  }
  .note-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
  }
  .more-link {
    display: inline-block;
    margin-top: 22px;
    font-size: 14px;
    font-weight: 600;
    color: var(--brand);
  }
  .project h3 a:hover,
  .video h3 a:hover {
    color: var(--brand);
  }
  .is-draft .note-title {
    color: var(--ink-2);
  }

  .about {
    position: sticky;
    top: 108px;
    padding: clamp(26px, 3vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }
  .about-title {
    margin-top: 18px;
    font-size: clamp(26px, 2.8vw, 34px);
    line-height: 1.35;
  }
  .about-title.en {
    font-size: clamp(24px, 2.3vw, 28px);
  }
  .about-body {
    margin-top: 18px;
    font-size: 15px;
    line-height: 1.9;
    color: var(--ink-2);
  }
  .journey {
    list-style: none;
    margin: 24px 0 0;
    padding: 22px 0 0;
    border-top: 1px solid var(--line-strong);
    display: grid;
    gap: 0;
  }
  .journey li {
    position: relative;
    padding: 0 0 14px 22px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .journey li::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid var(--brand);
    background: var(--surface-2);
  }
  .journey li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 18px;
    bottom: 0;
    width: 1px;
    background: var(--line-strong);
  }
  .journey li:last-child {
    padding-bottom: 0;
    color: var(--brand);
    font-weight: 600;
  }
  .journey li:last-child::before {
    background: var(--brand);
  }
  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 24px;
    font-size: 14px;
    font-weight: 600;
    color: var(--brand);
  }

  /* ── Projects ── */
  .projects {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .project {
    padding: 26px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .project-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .project-n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .project h3 {
    margin-top: 22px;
    font-size: 24px;
  }
  .project p {
    margin-top: 10px;
    font-size: 14.5px;
    color: var(--ink-2);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }

  /* ── Videos ── */
  .videos-band {
    padding: clamp(24px, 4vw, 44px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .videos-intro {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 20px 28px;
    align-items: center;
  }
  .videos-intro h2 {
    margin-top: 8px;
    font-size: clamp(24px, 3vw, 32px);
  }
  .videos-intro .aside {
    margin-top: 8px;
    color: var(--muted);
    font-size: 15px;
  }
  .play-badge {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 18px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
    margin-top: 32px;
  }
  .video-placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, color-mix(in srgb, var(--line) 55%, transparent) 14px 15px),
      var(--surface-2);
  }
  .video-topic {
    margin-top: 16px;
    font-size: 13px;
    color: var(--brand);
  }
  .video h3 {
