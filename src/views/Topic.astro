---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { topics, type Topic } from '../data/site';
import { localizePath, useT, type Lang } from '../i18n';

const { topic, lang } = Astro.props as { topic: Topic; lang: Lang };
const t = useT(lang);
const href = (slug: string) => localizePath(`/topics/${slug}/`, lang);
const i = topics.findIndex((t) => t.slug === topic.slug);
const prev = topics[i - 1];
const next = topics[i + 1];
const notes = (await getCollection('notes', ({ data }) => data.topic === topic.slug))
  .filter((n) => import.meta.env.DEV || !n.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout lang={lang} title={topic.title[lang]} description={topic.summary[lang]}>
  <section class="container head">
    <a class="back" href={`${localizePath('/', lang)}#map`}>{t.backToMap}</a>
    <p class="eyebrow">{topic.index} / {topic.en}</p>
    <h1>{topic.title[lang]}</h1>
    <p class="summary">{topic.summary[lang]}</p>
    <ul class="kw">{topic.keywords.map((k) => <li class="chip">{k[lang]}</li>)}</ul>
  </section>

  <section class="container body">
    <div>
      <h2>{t.published}</h2>
      {
        notes.length ? (
          <ul class="list">
            {notes.map((n) => {
              const text = lang === 'en' && n.data.en ? n.data.en : n.data;
              return (
              <li>
                <a href={`/notes/${n.id}/`}>
                  <span class="t">{text.title}</span>
                  <span class="d">{text.description}</span>
                  {n.data.draft && <span class="chip chip-soon">{t.draftLocal}</span>}
                </a>
              </li>
              );
            })}
          </ul>
        ) : (
          <p class="empty">{t.empty}</p>
        )
      }
    </div>
    <div>
      <h2>{t.planned}</h2>
      <ol class="outline">
        {
          topic.outline.map((o) => (
            <li>
              <span class="t">{o.title[lang]}</span>
              <span class="d">{o.question[lang]}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <nav class="container pager" aria-label={t.adjacent}>
    {prev ? <a href={href(prev.slug)}>← {prev.title[lang]}</a> : <span />}
    {next && <a href={href(next.slug)}>{next.title[lang]} →</a>}
  </nav>
</BaseLayout>

<style>
  .head {
    padding-block: clamp(40px, 7vw, 80px) 32px;
  }
  .back {
    display: inline-block;
    margin-bottom: 28px;
    font-size: 14px;
    color: var(--muted);
  }
  .back:hover {
    color: var(--brand);
  }
  h1 {
    margin-top: 14px;
    font-size: clamp(34px, 5vw, 54px);
  }
  .summary {
    margin-top: 16px;
    max-width: 40em;
    font-size: 18px;
    color: var(--ink-2);
  }
  .kw {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }
  .body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    padding-block: 32px 64px;
    border-top: 1px solid var(--line);
  }
  h2 {
    font-size: 22px;
    margin-bottom: 18px;
  }
  .list,
  .outline {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .list a,
  .outline li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .list a:hover .t {
    color: var(--brand);
  }
  .t {
    font-family: var(--font-serif);
    font-size: 18px;
  }
  .d,
  .empty {
    font-size: 14px;
    color: var(--muted);
  }
  .outline {
    counter-reset: o;
  }
  .outline li {
    counter-increment: o;
    position: relative;
    padding-left: 40px;
  }
  .outline li::before {
    content: counter(o, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 19px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 48px;
    font-size: 15px;
    color: var(--brand);
  }
  @media (max-width: 760px) {
    .body {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
