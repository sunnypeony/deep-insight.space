---
// 板块页：内容来自 content/topics/<lang>/<slug>.md；正文（可选）显示为板块导语。
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import { byDateDesc, entryHref, getLocalized, getTopics, hasBody, isVisible } from '../lib/content';
import { localizePath, useT, type Lang } from '../i18n';

const { slug, lang } = Astro.props as { slug: string; lang: Lang };
const t = useT(lang);
const topics = await getTopics(lang);
const i = topics.findIndex((tp) => tp.slug === slug);
const { entry } = topics[i];
const topic = entry.data;
const prev = topics[i - 1];
const next = topics[i + 1];
const { Content } = await render(entry);
const notes = (await getLocalized('notes', lang))
  .filter((n) => n.entry.data.topic === slug && isVisible(n.entry))
  .sort(byDateDesc);
---

<BaseLayout lang={lang} title={topic.title} description={topic.summary}>
  <section class="container head">
    <a class="back" href={`${localizePath('/', lang)}#map`}>{t.backToMap}</a>
    <p class="eyebrow">{String(i + 1).padStart(2, '0')} / {topic.eyebrow}</p>
    <h1>{topic.title}</h1>
    <p class="summary">{topic.summary}</p>
    <ul class="kw">{topic.keywords.map((k) => <li class="chip">{k}</li>)}</ul>
  </section>

  {
    hasBody(entry) && (
      <section class="container intro">
        <Prose>
          <Content />
        </Prose>
      </section>
    )
  }

  <section class="container body">
    <div>
      <h2>{t.published}</h2>
      {
        notes.length ? (
          <ul class="list">
            {notes.map((n) => (
              <li>
                <a href={entryHref('notes', n.lang, n.slug)}>
                  <span class="t">{n.entry.data.title}</span>
                  <span class="d">{n.entry.data.summary}</span>
                  <span class="badges">
                    {n.fallback && <span class="chip">{t.otherLang}</span>}
                    {n.entry.data.draft && <span class="chip chip-soon">{t.draftBadge}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">{t.empty}</p>
        )
      }
    </div>
    <div>
      <h2>{t.planned}</h2>
      <ol class="outline">
        {
          topic.outline.map((o) => (
            <li>
              <span class="t">{o.title}</span>
              <span class="d">{o.question}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <nav class="container pager" aria-label={t.adjacent}>
    {prev ? <a href={entryHref('topics', lang, prev.slug)}>← {prev.entry.data.title}</a> : <span />}
    {next && <a href={entryHref('topics', lang, next.slug)}>{next.entry.data.title} →</a>}
  </nav>
</BaseLayout>

<style>
  .head {
    padding-block: clamp(40px, 7vw, 80px) 32px;
  }
  .back {
    display: inline-block;
    margin-bottom: 28px;
    font-size: 14px;
    color: var(--muted);
  }
  .back:hover {
    color: var(--brand);
  }
  h1 {
    margin-top: 14px;
    font-size: clamp(34px, 5vw, 54px);
  }
  .summary {
    margin-top: 16px;
    max-width: 40em;
    font-size: 18px;
    color: var(--ink-2);
  }
  .kw {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }
  .intro {
    max-width: calc(760px + var(--gutter) * 2);
    margin-inline: 0;
    padding-bottom: 24px;
  }
  .badges {
    display: flex;
    gap: 6px;
  }
  .body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    padding-block: 32px 64px;
    border-top: 1px solid var(--line);
  }
  h2 {
    font-size: 22px;
    margin-bottom: 18px;
  }
  .list,
  .outline {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .list a,
  .outline li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .list a:hover .t {
    color: var(--brand);
  }
  .t {
    font-family: var(--font-serif);
    font-size: 18px;
  }
  .d,
  .empty {
    font-size: 14px;
    color: var(--muted);
  }
  .outline {
    counter-reset: o;
  }
  .outline li {
    counter-increment: o;
    position: relative;
    padding-left: 40px;
  }
  .outline li::before {
    content: counter(o, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 19px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 48px;
    font-size: 15px;
    color: var(--brand);
  }
  @media (max-width: 760px) {
    .body {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
