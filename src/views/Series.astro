---
// 系列页：content/series/<lang>/<slug>.md，正文是系列总览；下方按 seriesOrder 列出章节。
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import { mdxComponents } from '../components/mdx';
import {
  entryHref,
  formatDate,
  getSeriesChapters,
  getTopics,
  getTranslation,
  hasBody,
  isVisible,
  splitId,
} from '../lib/content';
import { useT } from '../i18n';

const { entry } = Astro.props as { entry: CollectionEntry<'series'> };
const { lang, slug } = splitId(entry.id);
const t = useT(lang);
const d = entry.data;
const { Content } = await render(entry);
const topic = (await getTopics(lang)).find((tp) => tp.slug === d.topic)!;
const chapters = await getSeriesChapters(lang, slug);
const translation = await getTranslation('series', lang, slug);
const tl = translation && splitId(translation.id).lang;
const alternates = { [lang]: entryHref('series', lang, slug), ...(tl ? { [tl]: entryHref('series', tl, slug) } : {}) };
---

<BaseLayout lang={lang} title={d.title} description={d.summary} alternates={alternates}>
  <article class="container page">
    <header>
      <a class="back" href={entryHref('topics', lang, d.topic)}>← {topic.entry.data.title}</a>
      <p class="eyebrow">{t.series} · {topic.entry.data.title}</p>
      <h1>{d.title}</h1>
      <p class="desc">{d.summary}</p>
      <p class="meta">
        <span>{t.chapterCount(chapters.length)}</span>
        <span>· <time datetime={d.date.toISOString()}>{formatDate(d.date, lang)}</time></span>
        {d.updated && <span>· {t.updated} {formatDate(d.updated, lang)}</span>}
        {d.draft && <span class="chip chip-soon">{t.draftBadge}</span>}
      </p>
    </header>

    {
      hasBody(entry) && (
        <Prose>
          <Content components={mdxComponents} />
        </Prose>
      )
    }

    <section class="chapters" aria-labelledby="chapters-title">
      <h2 id="chapters-title">{t.seriesChapters}</h2>
      <ol class="list">
        {
          chapters.map((c) => {
            const inner = (
              <>
                <span class="n">{t.chapter(c.order)}</span>
                <span class="main">
                  <span class="title">{c.entry.data.title}</span>
                  <span class="sum">{c.entry.data.summary}</span>
                </span>
                <span class="state">
                  {c.entry.data.draft ? (
                    <span class="chip chip-soon">{t.draft}</span>
                  ) : (
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                      <path d="M7 17 17 7M8 7h9v9" />
                    </svg>
                  )}
                </span>
              </>
            );
            return (
              <li>
                {isVisible(c.entry) ? (
                  <a class="row" href={entryHref('notes', lang, c.slug)}>
                    {inner}
                  </a>
                ) : (
                  <div class="row is-draft">{inner}</div>
                )}
              </li>
            );
          })
        }
      </ol>
    </section>
  </article>
</BaseLayout>

<style>
  .page {
    max-width: calc(860px + var(--gutter) * 2);
    padding-block: clamp(40px, 7vw, 80px);
  }
  .back {
    display: inline-block;
    margin-bottom: 28px;
    font-size: 14px;
    color: var(--muted);
  }
  .back:hover {
    color: var(--brand);
  }
  h1 {
    margin-top: 14px;
    font-size: clamp(32px, 4.8vw, 50px);
  }
  .desc {
    margin-top: 16px;
    font-size: 18px;
    color: var(--ink-2);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin-top: 18px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    color: var(--muted);
  }
  .chapters {
    margin-top: 48px;
  }
  .chapters h2 {
    font-size: 24px;
    margin-bottom: 16px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    counter-reset: none;
  }
  .list li {
    border-bottom: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr) auto;
    gap: 6px 24px;
    align-items: baseline;
    padding: 22px 4px;
  }
  a.row:hover .title {
    color: var(--brand);
  }
  .n {
    font-size: 13px;
    font-weight: 600;
    color: var(--brand);
    white-space: nowrap;
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .title {
    font-family: var(--font-serif);
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.45;
    color: var(--ink);
    transition: color 0.2s ease;
  }
  .is-draft .title {
    color: var(--ink-2);
  }
  .sum {
    font-size: 14px;
    color: var(--muted);
  }
  .state {
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .n {
      grid-column: 1 / -1;
    }
  }
</style>
