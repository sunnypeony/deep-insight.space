---
// 文章页：content/notes/<lang>/<slug>.md(x)
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import YouTube from '../components/YouTube.astro';
import { mdxComponents } from '../components/mdx';
import SeriesToc from '../components/series/SeriesToc.astro';
import SeriesNav from '../components/series/SeriesNav.astro';
import Giscus from '../components/Giscus.astro';
import { entryHref, formatDate, getSeriesContext, getTopics, getTranslation, splitId } from '../lib/content';
import { localizePath, useT } from '../i18n';

const { entry } = Astro.props as { entry: CollectionEntry<'notes'> };
const { lang, slug } = splitId(entry.id);
const t = useT(lang);
const d = entry.data;
const { Content } = await render(entry);
const topic = (await getTopics(lang)).find((tp) => tp.slug === d.topic)!;
const translation = await getTranslation('notes', lang, slug);
const alternates = {
  [lang]: entryHref('notes', lang, slug),
  ...(translation ? { [splitId(translation.id).lang]: entryHref('notes', splitId(translation.id).lang, slug) } : {}),
};
// 属于某个系列时：侧栏目录 + 上一章 / 下一章
const ctx = await getSeriesContext(entry);
const seriesHref = ctx && entryHref('series', lang, ctx.slug);
const toc = ctx && {
  lang,
  seriesTitle: ctx.series.data.title,
  seriesHref: seriesHref!,
  chapters: ctx.chapters,
  current: slug,
};
---

<BaseLayout lang={lang} title={d.title} description={d.summary} alternates={alternates} ogType="article">
  <div class:list={['container', 'layout', { 'has-series': ctx }]}>
  {
    toc && (
      <aside class="toc-side" aria-label={t.seriesContents}>
        <SeriesToc {...toc} />
      </aside>
    )
  }
  <article class="article">
    <header>
      {
        ctx ? (
          <a class="back" href={seriesHref}>{t.backToSeries}</a>
        ) : (
          <a class="back" href={localizePath('/notes/', lang)}>{t.backToNotes}</a>
        )
      }
      <p class="eyebrow">
        {
          ctx ? (
            <>
              <a href={seriesHref}>{ctx.series.data.title}</a> · {t.chapter(d.seriesOrder!)}
            </>
          ) : (
            <a href={entryHref('topics', lang, d.topic)}>{topic.entry.data.title}</a>
          )
        }
      </p>
      <h1>{d.title}</h1>
      <p class="desc">{d.summary}</p>
      <p class="meta">
        <time datetime={d.date.toISOString()}>{formatDate(d.date, lang)}</time>
        {d.updated && <span>· {t.updated} {formatDate(d.updated, lang)}</span>}
        {d.draft && <span class="chip chip-soon">{t.draftBadge}</span>}
      </p>
    </header>

    {
      toc && (
        <details class="toc-mobile">
          <summary>
            <span>{t.seriesContents}</span>
            <span class="pos">{t.chapterOf(d.seriesOrder!, ctx!.chapters.length)}</span>
          </summary>
          <SeriesToc {...toc} />
        </details>
      )
    }

    {
      d.youtubeId && (
        <div class="video">
          <YouTube id={d.youtubeId} title={d.title} lang={lang} />
        </div>
      )
    }

    <Prose>
      <Content components={mdxComponents} />
    </Prose>

    {
      d.tags.length > 0 && (
        <footer class="foot">
          <span class="sr-only">{t.tags}</span>
          {d.tags.map((tag) => (
            <span class="chip">#{tag}</span>
          ))}
        </footer>
      )
    }

    {d.comments && <Giscus lang={lang} term={`notes/${slug}`} />}

    {ctx && <SeriesNav lang={lang} prev={ctx.prev} next={ctx.next} />}
  </article>
  </div>
</BaseLayout>

<style>
  .layout {
    max-width: calc(760px + var(--gutter) * 2);
    padding-block: clamp(40px, 7vw, 80px);
  }
  .layout.has-series {
    display: grid;
    grid-template-columns: 250px minmax(0, 760px);
    justify-content: center;
    gap: 56px;
    max-width: calc(1066px + var(--gutter) * 2);
  }
  .article {
    min-width: 0;
  }
  .toc-side {
    position: sticky;
    top: 108px;
    align-self: start;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    padding-top: 6px;
  }
  .toc-mobile {
    display: none;
    margin-top: 24px;
    padding: 14px 18px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .toc-mobile summary {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: var(--brand);
  }
  .toc-mobile .pos {
    font-weight: 500;
    color: var(--muted);
  }
  .toc-mobile[open] summary {
    margin-bottom: 12px;
  }
  @media (max-width: 1100px) {
    .layout.has-series {
      display: block;
      max-width: calc(760px + var(--gutter) * 2);
    }
    .toc-side {
      display: none;
    }
    .toc-mobile {
      display: block;
    }
  }
  .back {
    display: inline-block;
    margin-bottom: 28px;
    font-size: 14px;
    color: var(--muted);
  }
  .back:hover,
  .eyebrow a:hover {
    color: var(--brand);
  }
  h1 {
    margin-top: 14px;
    font-size: clamp(30px, 4.4vw, 44px);
  }
  .desc {
    margin-top: 16px;
    font-size: 18px;
    color: var(--ink-2);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 18px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    color: var(--muted);
  }
  .video {
    margin-top: 32px;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
</style>
