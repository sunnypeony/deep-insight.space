---
// 全部笔记列表：/notes/ 与 /zh/notes/
import BaseLayout from '../layouts/BaseLayout.astro';
import { byDateDesc, entryHref, formatDate, getLocalized, getTopics, isVisible } from '../lib/content';
import { useT, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const topics = await getTopics(lang);
const topicTitle = new Map(topics.map((tp) => [tp.slug, tp.entry.data.title]));
const notes = (await getLocalized('notes', lang)).sort(byDateDesc);
---

<BaseLayout lang={lang} title={t.notesIndexTitle} description={t.notesIndexDescription}>
  <section class="container head">
    <p class="eyebrow">Notes</p>
    <h1>{t.notesIndexTitle}</h1>
    <p class="summary">{t.notesIndexDescription}</p>
  </section>
  <section class="container">
    <ul class="list">
      {
        notes.map((n) => {
          const d = n.entry.data;
          const inner = (
            <>
              <span class="date">{formatDate(d.date, lang)}</span>
              <span class="main">
                <span class="title">{d.title}</span>
                <span class="sum">{d.summary}</span>
                <span class="meta">
                  <span class="chip">{topicTitle.get(d.topic)}</span>
                  {n.fallback && <span class="chip">{t.otherLang}</span>}
                  {d.draft && <span class="chip chip-soon">{t.draft}</span>}
                </span>
              </span>
            </>
          );
          return (
            <li>
              {isVisible(n.entry) ? (
                <a class="row" href={entryHref('notes', n.lang, n.slug)}>
                  {inner}
                </a>
              ) : (
                <div class="row">{inner}</div>
              )}
            </li>
          );
        })
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .head {
    padding-block: clamp(40px, 7vw, 80px) 32px;
  }
  h1 {
    margin-top: 14px;
    font-size: clamp(34px, 5vw, 54px);
  }
  .summary {
    margin-top: 14px;
    font-size: 18px;
    color: var(--ink-2);
  }
  .list {
    list-style: none;
    margin: 0 0 72px;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .list li {
    border-bottom: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 8px 32px;
    padding: 26px 4px;
  }
  a.row:hover .title {
    color: var(--brand);
  }
  .date {
    font-size: 14px;
    color: var(--muted);
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .title {
    font-family: var(--font-serif);
    font-size: clamp(19px, 2.2vw, 24px);
    line-height: 1.45;
    transition: color 0.2s ease;
  }
  .sum {
    font-size: 15px;
    color: var(--muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
