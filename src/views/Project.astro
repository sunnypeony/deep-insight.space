---
// 项目页：content/projects/<lang>/<slug>.md(x)（有正文时才生成页面）
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import YouTube from '../components/YouTube.astro';
import { mdxComponents } from '../components/mdx';
import { entryHref, formatDate, getTranslation, hasBody, splitId } from '../lib/content';
import { localizePath, useT } from '../i18n';

const { entry } = Astro.props as { entry: CollectionEntry<'projects'> };
const { lang, slug } = splitId(entry.id);
const t = useT(lang);
const d = entry.data;
const { Content } = await render(entry);
const translation = await getTranslation('projects', lang, slug);
const tl = translation && hasBody(translation) ? splitId(translation.id).lang : undefined;
const alternates = { [lang]: entryHref('projects', lang, slug), ...(tl ? { [tl]: entryHref('projects', tl, slug) } : {}) };
const facts = [
  { k: t.role, v: d.role },
  { k: t.stack, v: d.stack.join(' · ') },
].filter((f) => f.v);
---

<BaseLayout
  lang={lang}
  title={d.title}
  description={d.summary}
  alternates={alternates}
  ogImage={`/og/${lang}/projects/${slug}.png`}
>
  <article class="container article">
    <header>
      <a class="back" href={`${localizePath('/', lang)}#projects`}>{t.backToProjects}</a>
      <p class="eyebrow">
        {t.status[d.status]} · {formatDate(d.date, lang)}
        {d.draft && <span class="chip chip-soon">{t.draftBadge}</span>}
      </p>
      <h1>{d.title}</h1>
      <p class="desc">{d.summary}</p>
      {
        (facts.length > 0 || d.links.length > 0) && (
          <dl class="facts">
            {facts.map((f) => (
              <div>
                <dt>{f.k}</dt>
                <dd>{f.v}</dd>
              </div>
            ))}
            {d.links.length > 0 && (
              <div>
                <dt>{t.links}</dt>
                <dd class="links">
                  {d.links.map((l) => (
                    <a href={l.url} target="_blank" rel="noopener">
                      {l.label} ↗
                    </a>
                  ))}
                </dd>
              </div>
            )}
          </dl>
        )
      }
      <ul class="tags">{d.tags.map((tag) => <li class="chip">{tag}</li>)}</ul>
    </header>

    {
      d.youtubeId && (
        <div class="video">
          <YouTube id={d.youtubeId} title={d.title} lang={lang} />
        </div>
      )
    }

    <Prose>
      <Content components={mdxComponents} />
    </Prose>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: calc(760px + var(--gutter) * 2);
    padding-block: clamp(40px, 7vw, 80px);
  }
  .back {
    display: inline-block;
    margin-bottom: 28px;
    font-size: 14px;
    color: var(--muted);
  }
  .back:hover {
    color: var(--brand);
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  h1 {
    margin-top: 14px;
    font-size: clamp(32px, 4.6vw, 48px);
  }
  .desc {
    margin-top: 16px;
    font-size: 18px;
    color: var(--ink-2);
  }
  .facts {
    display: grid;
    gap: 10px;
    margin: 24px 0 0;
    padding: 18px 20px;
    border-radius: 14px;
    background: var(--surface-2);
    font-size: 14.5px;
  }
  .facts div {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 12px;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    color: var(--ink-2);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .links a {
    color: var(--brand);
    font-weight: 600;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 20px 0 0;
    padding: 0 0 28px;
    border-bottom: 1px solid var(--line);
  }
  .video {
    margin-top: 32px;
  }
</style>
